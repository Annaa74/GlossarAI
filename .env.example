# Firebase project config — fill in to enable cloud sync.
# All variables MUST be prefixed with EXPO_PUBLIC_ to be exposed to the app at runtime.
# Without these the app runs in fully-offline guest mode.

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: Expo project ID for push tokens (only used in development builds).
EXPO_PUBLIC_PROJECT_ID=

# Google sign-in (OAuth 2.0 client IDs from Google Cloud Console).
# Required to render the "Continue with Google" button on auth screens.
# - Android: created with package id com.glosserai.app + your dev/release SHA-1
# - Web:     usually auto-created when you enable Google in Firebase Console
# - iOS:     only needed if you ship iOS
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Layer 1 vocab freshness — URL to a JSON manifest of trending terms.
# Recommended: a `vocab.json` in this repo, served via raw.githubusercontent.com.
# Schema documented in services/vocabManifest.ts.
EXPO_PUBLIC_VOCAB_MANIFEST_URL=
